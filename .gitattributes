# Store text with LF line endings in the repository; Git picks the right ones on checkout.
* text=auto

*.py       text eol=lf
*.spec     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.json     text eol=lf
*.txt      text eol=lf
*.svg      text eol=lf
*.plist    text eol=lf
*.desktop  text eol=lf
*.sh       text eol=lf
*.iss      text
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.icns     binary
*.bmp      binary
*.dmg      binary
*.webp     binary
*.pdf      binary
